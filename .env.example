# Database
DATABASE_URL="postgresql://localhost:5432/wms_db"
# Docker Compose default:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/wms_db"

# Demo builds: quick role login on /login when set to true (omit in production)
IS_DEMO=""

# JWT Auth
JWT_SECRET="generate-with: openssl rand -base64 32"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Image uploads (ImgBB)
# Server-side key (preferred)
IMGBB_API_KEY=""
# Or client-side key (if needed)
NEXT_PUBLIC_IMGBB_API_KEY=""

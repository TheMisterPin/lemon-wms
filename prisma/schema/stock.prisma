// =============================================================================
// stock.prisma
// Physical stock records — where things are and how many.
//
// BinStockItem is the intersection of location × catalog × tracking identifier.
// Current quantity is NEVER stored as a snapshot — it is always derived from
// ItemLedgerEntry via SUM(quantityDelta). BinStockItem stores the operational
// quantities (available, reserved, blocked) that drive floor execution.
//
// Models: BinStockItem, Lot, SerialNumber, Box, BoxLine
//
// Dependencies:
//   → locations.prisma (Bin, Warehouse)
//   → catalog.prisma (Item, UnitOfMeasure, SerialNumberConfig)
//   → iam.prisma (Device) — transit device tracking
// =============================================================================

// One row per unique combination of bin × item × lot (or × serial for serial-tracked).
// Uniqueness is enforced by three partial unique indexes — see TESTING.md for the
// raw SQL migrations that create them, as Prisma does not support conditional indexes.
//
// Quantity semantics:
//   quantityAvailable — free stock, can be picked
//   quantityReserved  — committed to an open order, still physically in bin
//   quantityBlocked   — quarantine hold, cannot be picked or reserved
//   usable            = quantityAvailable - quantityReserved
//
// Check constraint (raw SQL migration required):
//   quantityAvailable >= 0
model BinStockItem {
  id                        String                     @id @default(uuid())
  warehouseId               String
  binId                     String
  itemId                    String
  lotId                     String?
  serialNumberId            String?
  quantityAvailable         Decimal                    @default(0) @db.Decimal(18, 4)
  quantityReserved          Decimal                    @default(0) @db.Decimal(18, 4)
  quantityBlocked           Decimal                    @default(0) @db.Decimal(18, 4)
  uom                       String
  status                    BinItemStatus              @default(AVAILABLE)
  transitDeviceId           String? // Set during IN_TRANSIT operations
  transitTrolleyId          String?
  expiryDate                DateTime? // For perishables — drives expiry alert
  name                      String // Snapshot of item name at time of stock creation
  sku                       String // Snapshot of item SKU at time of stock creation
  reservedByOrderId         String?
  reservedByOrderLineId     String?
  createdByBoeId            String?
  lastOperationBoeId        String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  boxId                     String?
  purchaseOrderReceiptLines PurchaseOrderReceiptLine[] @relation("BinStockItemPurchaseOrderReceiptLines")
  salesOrderPickLines       SalesOrderPickLine[]       @relation("BinStockItemSalesOrderPickLines")
  transferOrderPickLines    TransferOrderPickLine[]    @relation("BinStockItemTransferOrderPickLines")
  returnOrderPickLines      ReturnOrderPickLine[]      @relation("BinStockItemReturnOrderPickLines")
  adjustmentOrderPickLines  AdjustmentOrderPickLine[]  @relation("BinStockItemAdjustmentOrderPickLines")

  bin            Bin           @relation(fields: [binId], references: [id])
  item           Item          @relation(fields: [itemId], references: [id])
  lot            Lot?          @relation(fields: [lotId], references: [id])
  serialNumber   SerialNumber? @relation(fields: [serialNumberId], references: [id])
  unitOfMeasure  UnitOfMeasure @relation(fields: [uom], references: [id])
  transitDevice  Device?       @relation("TransitBinStockItems", fields: [transitDeviceId], references: [id])
  transitTrolley Trolley?      @relation("TransitTrolleyStockItems", fields: [transitTrolleyId], references: [id])
  boxLines       BoxLine[]

  @@unique([binId, itemId, lotId, serialNumberId, status, transitDeviceId, transitTrolleyId])
  @@index([warehouseId, itemId])
  @@index([binId, itemId])
  @@index([status])
  @@index([transitTrolleyId])
}

// A physical batch of items received together. Created at receive time.
// lotNumber is generated by the receiving service from the PurchaseOrder reference
// and receiving sequence — it is not user-entered.
model Lot {
  id              String    @id @default(uuid())
  lotNumber       String    @unique
  purchaseOrderId String?
  receivedDate    DateTime
  expiryDate      DateTime?
  status          LotStatus @default(ACTIVE)
  itemId          String?
  createdAt       DateTime  @default(now())

  item          Item?          @relation(fields: [itemId], references: [id])
  binStockItems BinStockItem[]
  boxLines      BoxLine[]

  @@index([itemId])
  @@index([purchaseOrderId])
  @@index([receivedDate])
  @@index([expiryDate])
  @@index([status])
}

// One physical unit of a SERIAL-tracked item.
// Generated by the receiving service via SerialNumberConfig — not user-created.
model SerialNumber {
  id             String           @id @default(uuid())
  serial         String           @unique
  configId       String
  entityType     SerialEntityType
  baseValue      Int
  partialCurrent Int?
  partialTotal   Int?
  status         SerialStatus     @default(IN_STOCK)
  itemId         String?
  createdAt      DateTime         @default(now())

  config        SerialNumberConfig @relation(fields: [configId], references: [id])
  item          Item?              @relation(fields: [itemId], references: [id])
  binStockItems BinStockItem[]
  boxLines      BoxLine[]
}

// Box model — deferred for post-MVP.
// Schema exists to preserve FK references. No API routes or service logic for MVP.
model Box {
  id          String    @id @default(uuid())
  code        String    @unique
  status      BoxStatus @default(OPEN)
  binId       String?
  warehouseId String
  weightKg    Decimal?
  notes       String?
  createdAt   DateTime  @default(now())

  bin       Bin?      @relation(fields: [binId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lines     BoxLine[]
}

// BoxLine model — deferred for post-MVP. See Box above.
model BoxLine {
  id             String   @id @default(uuid())
  boxId          String
  itemId         String
  quantity       Decimal
  lotId          String?
  serialNumberId String?
  uom            String
  createdAt      DateTime @default(now())

  box           Box           @relation(fields: [boxId], references: [id], onDelete: Cascade)
  item          BinStockItem  @relation(fields: [itemId], references: [id])
  lot           Lot?          @relation(fields: [lotId], references: [id])
  serialNumber  SerialNumber? @relation(fields: [serialNumberId], references: [id])
  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])
}

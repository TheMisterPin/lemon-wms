// =============================================================================
// orders.prisma
// All five order types and their lines. OrderAssignment.
//
// All order types share the same status machine:
//   DRAFT → CONFIRMED → RELEASED → EXECUTING ⇄ PAUSED
//     → EXECUTED | EXECUTED_WITH_PROBLEMS
//     → SIGNED_OFF
//     → CANCELLED (from any pre-EXECUTED status)
//
// When an order closes with EXECUTED_WITH_PROBLEMS, the WM can trigger a split:
//   parent order → /1 child (COMPLETED — the handled portion)
//                → /2 child (DRAFT — the remainder, re-enters OM workflow)
//
// Models:
//   PurchaseOrder, PurchaseOrderLine, PurchaseOrderReceiptLine
//   SalesOrder, SalesOrderLine
//   TransferOrder, TransferOrderLine
//   ReturnOrder, ReturnOrderLine
//   AdjustmentOrder, AdjustmentOrderLine
//   OrderAssignment
//
// Dependencies:
//   → locations.prisma (Warehouse, Bin)
//   → catalog.prisma (Item, UnitOfMeasure)
//   → stock.prisma (Lot, SerialNumber)
//   → parties.prisma (BusinessParty)
//   → iam.prisma (User)
//   → logs.prisma (UserActivityEntry)
//   → logs.prisma (OrderAssignment)
//   → logs.prisma (OrderExecutionActivity)
// =============================================================================

// =============================================================================
// Purchase Orders — inbound stock from suppliers
// =============================================================================

// kind = MASTER: the original order created by OM
// kind = RECEIPT: a child order created when a MASTER closes with problems (the /2 remainder)
// receivingSequence: incremented per warehouse per calendar day — used for FIFO stamping
model PurchaseOrder {
  id                   String        @id @default(uuid())
  reference            String        @unique
  status               OrderStatus   @default(DRAFT)
  priority             OrderPriority @default(NORMAL)
  warehouseId          String
  businessPartyId      String?
  supplierNameSnapshot String?
  notes                String?

  createdById          String
  confirmedById        String?
  confirmedAt          DateTime?
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  executionStartedAt   DateTime?
  executionCompletedAt DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())

  totalReceivedQuantity Decimal @default(0) @db.Decimal(18, 4)
  totalOpenQuantity     Decimal @default(0) @db.Decimal(18, 4)
  completedLines        Int     @default(0)
  openLines             Int     @default(0)
  totalLines            Int     @default(0)

  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  businessParty BusinessParty? @relation("SupplierPurchaseOrders", fields: [businessPartyId], references: [id])

  lines    PurchaseOrderLine[]
  receipts PurchaseOrderReceipt[]

  @@index([warehouseId, status])
  @@index([businessPartyId])
  @@index([status])
}



model PurchaseOrderReceipt {
  id                   String        @id @default(uuid())
  reference            String        @unique
  purchaseOrderId      String
  status               ReceiptStatus @default(OPEN)
  warehouseId          String
  supplierNameSnapshot String?
  notes                String?

  receivingSequence Int @default(0)
  createdById       String
  startedById       String?
  completedById     String?
  startedAt         DateTime?
  completedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())

  totalProcessedQuantity Decimal @default(0) @db.Decimal(18, 4)
  totalAcceptedQuantity  Decimal @default(0) @db.Decimal(18, 4)
  totalRejectedQuantity  Decimal @default(0) @db.Decimal(18, 4)
  totalQuarantinedQty    Decimal @default(0) @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])

  lines PurchaseOrderReceiptLine[]

  @@index([purchaseOrderId])
  @@index([warehouseId, status])
  @@index([status])
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  lineSequence     Int @default(0)
  itemId           String
  itemNameSnapshot String
  
  uom              String
  notes            String?
  orderedQuantity  Decimal @db.Decimal(18, 4)
  purchaseOrder PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure              @relation(fields: [uom], references: [id])
  receiptLines  PurchaseOrderReceiptLine[]

  @@unique([purchaseOrderId, lineSequence])
  @@index([purchaseOrderId])
  @@index([itemId])
}
model PurchaseOrderReceiptLine {
  id                     String @id @default(uuid())
  purchaseOrderReceiptId String
  purchaseOrderLineId    String

  quantity         Decimal       @db.Decimal(18, 4)@default(0)
  orderedQuantity Decimal        @db.Decimal(18, 4)
  uom              String
  itemId           String
  itemNameSnapshot String
  disposition      ReceiptOutcome @default(ACCEPTED)
  notes            String?

  orderExecutionActivityId String?
  correctionOfLineId       String?
  createdAt                DateTime @default(now())

  receiptLine       PurchaseOrderReceipt       @relation(fields: [purchaseOrderReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine          @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  correctedLine     PurchaseOrderReceiptLine?  @relation("ReceiptLineCorrections", fields: [correctionOfLineId], references: [id])
  correctionLines   PurchaseOrderReceiptLine[] @relation("ReceiptLineCorrections")

  stockItems BinStockItem[] @relation("BinStockItemPurchaseOrderReceiptLines")

  @@index([purchaseOrderReceiptId])
  @@index([purchaseOrderLineId])
  @@index([disposition])
  @@index([correctionOfLineId])
}

// =============================================================================
// Sales Orders — outbound stock to customers
// =============================================================================

model SalesOrder {
  id              String        @id @default(uuid())
  reference       String        @unique
  status          OrderStatus   @default(DRAFT)
  priority        OrderPriority @default(NORMAL)
  warehouseId     String
  businessPartyId String?
  customerName    String // Required — denormalized for display
  deliveryAddress String?
  carrierId       String?
  notes           String?
  createdById     String
  confirmedById   String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  businessParty BusinessParty? @relation("CustomerSalesOrders", fields: [businessPartyId], references: [id])

  lines SalesOrderLine[]

  @@index([warehouseId, status])
  @@index([businessPartyId])
}

model SalesOrderLine {
  id               String  @id @default(uuid())
  salesOrderId     String
  itemId           String
  itemNameSnapshot String
  destinationBinId String?
  originBinId      String?
  baseQuantity     Decimal @db.Decimal(18, 4)
  handledQuantity  Decimal @default(0) @db.Decimal(18, 4)
  isShort          Boolean @default(false)
  lotId            String?
  serialNumberId   String?
  uom              String

  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])

  @@index([salesOrderId])
  @@index([itemId])
}

// =============================================================================
// Transfer Orders — stock movement between bins or warehouses
// =============================================================================

// isCrossWarehouse = true: two ILEs written on completion (TRANSFER_OUT + TRANSFER_IN)
// isCrossWarehouse = false: BOE MOVE only — no ILE (intra-warehouse, fiscal stock unchanged)
model TransferOrder {
  id               String        @id @default(uuid())
  reference        String        @unique
  status           OrderStatus   @default(DRAFT)
  priority         OrderPriority @default(NORMAL)
  warehouseId      String
  notes            String?
  originBinId      String?
  destinationBinId String?
  isCrossWarehouse Boolean       @default(false)
  createdById      String
  confirmedById    String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())

  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  originBin      Bin?      @relation("TransferFromBin", fields: [originBinId], references: [id])
  destinationBin Bin?      @relation("TransferToBin", fields: [destinationBinId], references: [id])

  lines TransferOrderLine[]

  @@index([warehouseId, status])
}

model TransferOrderLine {
  id               String  @id @default(uuid())
  transferOrderId  String
  itemId           String
  itemNameSnapshot String
  binId            String?
  baseQuantity     Decimal @db.Decimal(18, 4)
  handledQuantity  Decimal @default(0) @db.Decimal(18, 4)
  isShort          Boolean @default(false)
  lotId            String?
  serialNumberId   String?
  uom              String

  transferOrder TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])

  @@index([transferOrderId])
  @@index([itemId])
}

// =============================================================================
// Return Orders — inbound stock from customers
// =============================================================================

// originSalesOrderId links back to the SO this return came from (optional).
// returnDisposition: RESTOCK | QUARANTINE | SCRAP | RETURN_TO_SUPPLIER
//   Determines what happens to stock on order completion.
model ReturnOrder {
  id                 String        @id @default(uuid())
  reference          String        @unique
  status             OrderStatus   @default(DRAFT)
  priority           OrderPriority @default(NORMAL)
  warehouseId        String
  notes              String?
  originSalesOrderId String?
  returnDisposition  String?
  createdById        String
  confirmedById      String?
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  lines ReturnOrderLine[]

  @@index([warehouseId, status])
  @@index([originSalesOrderId])
}

model ReturnOrderLine {
  id               String  @id @default(uuid())
  returnOrderId    String
  itemId           String
  itemNameSnapshot String
  binId            String?
  baseQuantity     Decimal @db.Decimal(18, 4)
  handledQuantity  Decimal @default(0) @db.Decimal(18, 4)
  isShort          Boolean @default(false)
  lotId            String?
  serialNumberId   String?
  uom              String

  returnOrder   ReturnOrder   @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])

  @@index([returnOrderId])
  @@index([itemId])
}

// =============================================================================
// Adjustment Orders — stock corrections with full audit trail
// =============================================================================

// reasonCode: CYCLE_COUNT | DAMAGE | SHRINKAGE | FOUND | CORRECTION | OTHER
// Requires WM/OM approval before execution (CONFIRMED → RELEASED).
// Each line writes an ILE: ADJUSTMENT_IN (positive delta) or ADJUSTMENT_OUT (negative).
model AdjustmentOrder {
  id            String        @id @default(uuid())
  reference     String        @unique
  status        OrderStatus   @default(DRAFT)
  priority      OrderPriority @default(NORMAL)
  warehouseId   String
  notes         String?
  reasonCode    String
  createdById   String
  confirmedById String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  lines AdjustmentOrderLine[]

  @@index([warehouseId, status])
  @@index([reasonCode])
}

// sequence is the composite PK component — auto-increments per order.
model AdjustmentOrderLine {
  adjustmentOrderId String
  sequence          Int     @default(autoincrement())
  itemId            String
  itemNameSnapshot  String
  binId             String?
  baseQuantity      Decimal @db.Decimal(18, 4)
  handledQuantity   Decimal @default(0) @db.Decimal(18, 4)
  isShort           Boolean @default(false)
  lotId             String?
  serialNumberId    String?
  uom               String

  adjustmentOrder AdjustmentOrder @relation(fields: [adjustmentOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure   UnitOfMeasure   @relation(fields: [uom], references: [id])

  @@id([adjustmentOrderId, sequence])
  @@index([adjustmentOrderId])
  @@index([itemId])
}

// =============================================================================
// logs.prisma
// The three-layer immutable audit log.
//
// These three models always write together in a single transaction.
// They never write alone. The write order is always: UAE → BOE → ILE.
// This is enforced in lib/logs/log.service.ts — it is the only place that
// writes to these tables.
//
// RULE: Never call prisma.userActivityEntry.create() directly from an API route
//       or any service other than log.service.ts.
//
// RULE: Never update or delete any row in these tables. Ever.
//       Mistakes are corrected with compensating entries (opposite values).
//       The original entry and its reversal are both preserved.
//
// RULE: Timestamps are set by the database (@default(now())) — never by the app.
//       This prevents clock skew from corrupting chronological order.
//
// Models: UserActivityEntry, BinOperationEntry, ItemLedgerEntry
//
// Dependencies:
//   → iam.prisma (User, Warehouse)
//   → catalog.prisma (UnitOfMeasure)
// =============================================================================

// Layer 1 — WHO did WHAT to WHICH entity and WHEN.
// Written for every meaningful user action — not just stock movements.
// See 02-users.md for the full actionType list.
model UserActivityEntry {
  id                String     @id @default(uuid())
  userId            String
  actionType        String // e.g. "LINE_HANDLED", "BIN_BLOCKED", "USER_CREATED"
  entityType        String // e.g. "PurchaseOrder", "Bin", "User"
  entityId          String
  metadata          Json? // Action-specific payload — structure defined per actionType
  warehouseId       String?
  zoneId            String?
  deviceId          String?
  trolleyId         String?
  orderId           String?
  orderType         OrderType?
  ipAddress         String?
  notes             String? // Human-readable freeform — NOT for structured data
  orderAssignmentId String?
  createdAt         DateTime   @default(now())

  user      User                @relation(fields: [userId], references: [id])
  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id])
  zone      Zone?               @relation(fields: [zoneId], references: [id])
  device    Device?             @relation("DeviceActivityEntries", fields: [deviceId], references: [id])
  trolley   Trolley?            @relation("TrolleyActivityEntries", fields: [trolleyId], references: [id])
  // Reverse relations — each order type links its UAE
  boes      BinOperationEntry[]

  @@index([userId, actionType, entityType, entityId])
  @@index([orderId, orderType])
  @@index([createdAt])
  @@index([orderAssignmentId])
}

// Layer 2 — WHAT MOVED, from WHERE to WHERE.
// Written for every physical stock movement or operation.
// affectsFiscalStock = true means an ILE must be written alongside this BOE.
// affectsFiscalStock = false means intra-warehouse move — no ILE needed.
//
// FIFO stamping: for RECEIVE operations on FIFO-tracked items, receivingDate and
// receivingSequence are set here from the PurchaseOrder. These values are immutable
// once written — they cannot be reconstructed later via joins.
model BinOperationEntry {
  id                  String           @id @default(uuid())
  userId              String
  warehouseId         String
  zoneId              String
  deviceId            String?
  trolleyId           String?
  type                BinOperationType
  fromBinId           String?
  toBinId             String?
  warItemId           String
  quantity            Decimal          @db.Decimal(18, 4)
  uom                 String
  lotId               String?
  serialNumberId      String?
  orderId             String?
  orderType           OrderType?
  affectsFiscalStock  Boolean          @default(false)
  boxId               String?
  notes               String?
  reasonCode          String?
  reversedByEntryId   String? // Points to the compensating BOE if this was reversed
  reversesEntryId     String? // Points to the original BOE this entry reverses
  userActivityEntryId String?
  orderExecutionActivityId String?
  createdAt           DateTime         @default(now())

  user              User               @relation(fields: [userId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  zone              Zone?              @relation(fields: [zoneId], references: [id])
  device            Device?            @relation("DeviceBinOperations", fields: [deviceId], references: [id])
  trolley           Trolley?           @relation("TrolleyBinOperations", fields: [trolleyId], references: [id])
  unitOfMeasure     UnitOfMeasure      @relation(fields: [uom], references: [id])
  userActivityEntry UserActivityEntry? @relation(fields: [userActivityEntryId], references: [id])
  itemLedgers ItemLedgerEntry[]

  @@index([warehouseId, warItemId, createdAt])
  @@index([fromBinId, createdAt])
  @@index([toBinId, createdAt])
  @@index([type, createdAt])
  @@index([orderType, orderId])
  @@index([orderExecutionActivityId])
}

// Layer 3 — FISCAL STOCK IMPACT.
// Written only when affectsFiscalStock = true on the parent BOE.
// Current stock for any item = SUM(quantityDelta) filtered by warehouseId + warItemId.
// There is no snapshot field anywhere in the system. The ledger is the source of truth.
//
// id is an autoincrement integer — provides a guaranteed global ordering within
// the warehouse that UUIDs cannot provide.
model ItemLedgerEntry {
  id                  Int                      @id @default(autoincrement())
  warehouseId         String
  warItemId           String
  zoneId              String
  uom                 String
  eventType           FiscalInventoryEventType
  quantityDelta       Decimal                  @db.Decimal(18, 4) // Positive = stock in, Negative = stock out
  lotId               String?
  serialNumberId      String?
  orderId             String?
  orderType           OrderType?
  boeId               String?
  reference           String? // Human-readable order reference snapshot
  externalDocumentRef String?
  performedByUserId   String?
  reasonCode          String?
  createdAt           DateTime                 @default(now())

  boe           BinOperationEntry? @relation(fields: [boeId], references: [id])
  unitOfMeasure UnitOfMeasure      @relation(fields: [uom], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  zone          Zone               @relation(fields: [zoneId], references: [id])

  @@index([warehouseId, warItemId, createdAt])
  @@index([warehouseId, eventType, createdAt])
  @@index([orderType, orderId])
  @@index([lotId])
  @@index([serialNumberId])
}

// Layer 4 — ORDER ASSIGNMENT SESSION.
// Represents the current execution session for one user on one order.
// This is a parent session record, not a full event-history table.
// It stores the current assignment status, key lifecycle timestamps,
// and acts as the container for execution activities performed during the session.
// The unique constraint prevents duplicate assignment sessions for the same
// (orderType, orderId, userId) combination.
model OrderAssignment {
  id          String              @id @default(uuid())
  orderId     String
  orderType   OrderType
  status      AssignmentLifecycle
  warehouseId String
  zoneId      String?
  userId      String
  deviceId    String?
  trolleyId   String?

  // Key session timestamps.
  // These represent important lifecycle milestones on the parent session record.
  // They are not intended to be a full pause/resume event history.
  assignedAt  DateTime  @default(now())
  startedAt   DateTime?
  pausedAt    DateTime?
  releasedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  timedOutAt  DateTime?

  notes    String?
  isActive Boolean @default(true)

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse  Warehouse                @relation(fields: [warehouseId], references: [id])
  activities OrderExecutionActivity[] @relation("ActivitiesPerformedInSession")
  zone       Zone?                    @relation(fields: [zoneId], references: [id])
  device     Device?                  @relation("DeviceOrderAssignments", fields: [deviceId], references: [id])
  trolley    Trolley?                 @relation("TrolleyOrderAssignments", fields: [trolleyId], references: [id])

  @@unique([orderType, orderId, userId])
  @@index([userId, assignedAt])
  @@index([orderType, orderId])
  @@index([warehouseId, assignedAt])
  @@index([status, assignedAt])
}

// Layer 5 — ORDER EXECUTION ACTIVITY.
// Stores meaningful business execution actions performed within an order assignment.
// This is the readable execution trail for warehouse work such as picking,
// receiving, checking, packing, skipping, or resolving exceptions.
// It records actor, order context, optional line context, warehouse context,
// and timestamp. It does not replace stock movement entries or current-state
// order line fields.
// orderLineRefId: master order line id (no FK).
// executionLineDocument + executionLineId: receipt/pick execution line id (no FK).
model OrderExecutionActivity {
  id                String            @id @default(uuid())
  orderAssignmentId String
  userId            String
  warehouseId       String
  zoneId            String
  deviceId          String?
  trolleyId         String?
  activityType      ExecutionActivity
  orderId           String
  orderType         OrderType
  orderLineRefId    String?
  executionLineDocument OrderExecutionLineDocument?
  executionLineId     String?
  notes             String?
  createdAt         DateTime          @default(now())
  binOperationEntryId String?

  orderAssignment OrderAssignment @relation("ActivitiesPerformedInSession", fields: [orderAssignmentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  zone            Zone            @relation(fields: [zoneId], references: [id])
  device          Device?         @relation("DeviceExecutionActivities", fields: [deviceId], references: [id])
  trolley         Trolley?        @relation("TrolleyExecutionActivities", fields: [trolleyId], references: [id])

  @@index([orderAssignmentId, createdAt])
  @@index([orderType, orderId, createdAt])
  @@index([userId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([activityType, createdAt])
  @@index([binOperationEntryId])
}

// Daily bin-level aggregates for dashboards (distinct from immutable BOEs).
// Snapshot `date` is stored at 00:00:00 UTC for the calendar day.
model BinHistory {
  id               String   @id @default(uuid())
  binId            String
  date             DateTime
  quantityOnHand   Decimal  @db.Decimal(18, 4)
  quantityBlocked  Decimal  @db.Decimal(18, 4)
  quantityReserved Decimal  @db.Decimal(18, 4)
  createdAt        DateTime @default(now())

  bin Bin @relation(fields: [binId], references: [id])

  @@unique([binId, date])
  @@index([binId, date])
  @@index([date])
}

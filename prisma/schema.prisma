generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  OFFICE_MANAGER
  OFFICE_WORKER
  WAREHOUSE_MANAGER
  WAREHOUSE_WORKER
}

enum LoginType {
  CREDENTIAL
  BADGE_PIN
  BOTH
}

enum LoginMode {
  PIN
  AUTOMATIC
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ZoneType {
  RECEIVING
  STORAGE
  PICKING
  PACKING
  SHIPPING
  QUARANTINE
  CUSTOM
}

enum BinType {
  RECEIVING
  STORAGE
  PICKING
  PACKING
  SHIPPING
  QUARANTINE
  STAGING
  CUSTOM
}

enum BinItemStatus {
  AVAILABLE
  RESERVED
  BLOCKED
  IN_TRANSIT
}

enum ItemTrackingMode {
  NONE
  LOT
  SERIAL
  FIFO
}

enum LotStatus {
  ACTIVE
  QUARANTINE
  EXPIRED
  CONSUMED
}

enum SerialStatus {
  IN_STOCK
  SHIPPED
  RETURNED
  SCRAPPED
}

enum SerialEntityType {
  ITEM
  BOX
  BOX_LINE
  PALLET
  ORDER
  ORDER_LINE
  USER
}

enum SerialMode {
  INCREMENTAL
  PARTIAL
}

enum BoxStatus {
  OPEN
  SEALED
  IN_TRANSIT
  RECEIVED
  SHIPPED
  SCRAPPED
}

enum OrderPriority {
  NORMAL
  URGENT
  EXPRESS
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  RELEASED
  EXECUTING
  PAUSED
  EXECUTED
  EXECUTED_WITH_PROBLEMS
  SIGNED_OFF
  CANCELLED
}

enum OrderType {
  PURCHASE
  SALES
  TRANSFER
  RETURN
  ADJUSTMENT
}

enum LedgerEntryType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  TRANSFER
}

enum AlertRuleType {
  LOW_STOCK
  EXPIRY
  BIN_CAPACITY
}

enum DeviceType {
  FLOOR
}

model Warehouse {
  id          String          @id
  name        String          @unique
  address     String?
  timezone    String?
  currency    String?
  status      WarehouseStatus @default(ACTIVE)
  createdById String?
  createdBy   User?           @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())

  zones          Zone[]
  bins           Bin[]
  devices        Device[]
  assignments    WarehouseAssignment[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  transferOrders TransferOrder[]
  returnOrders   ReturnOrder[]
  adjustOrders   AdjustmentOrder[]
  itemLedger     ItemLedgerEntry[]
  alertRules     AlertRule[]
  uaeEntries     UserActivityEntry[]
  serialConfigs  SerialNumberConfig[]
  boxes          Box[]
}

model Zone {
  id                     String    @id
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  name                   String
  type                   ZoneType
  customPermissions      Json?
  isActive               Boolean   @default(true)
  defaultReceivingBinId  String?
  defaultQuarantineBinId String?
  defaultOutgoingBinId   String?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())

  bins        Bin[]
  devices     Device[]
  assignments WarehouseAssignment[]

  @@unique([warehouseId, name])
}

model Bin {
  id          String    @id
  zoneId      String
  warehouseId String
  zone        Zone      @relation(fields: [zoneId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  name        String
  code        String    @unique
  type        BinType
  isBlocked   Boolean   @default(false)
  blockReason String?
  maxWeightKg Decimal?
  maxVolumeM3 Decimal?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  binItems      BinItem[]
  fromTransfers TransferOrder[] @relation("TransferFromBin")
  toTransfers   TransferOrder[] @relation("TransferToBin")
  boxes         Box[]
}

model User {
  id                String    @id
  email             String?   @unique
  passwordHash      String?
  badgeNumber       String    @unique
  pinHash           String?
  firstName         String
  lastName          String
  fullName          String    @default("${firstName} ${lastName}")
  role              Role
  loginType         LoginType
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  lastLoginDeviceId String?

  lastLoginDevice      Device?               @relation("UserLastDevice", fields: [lastLoginDeviceId], references: [id])
  usedByDevices        Device[]              @relation("DeviceLastUser") // ← back-relation for Device.lastUser
  refreshTokens        RefreshToken[]
  warehouseAssignments WarehouseAssignment[]
  createdWarehouses    Warehouse[]           @relation("WarehouseCreatedBy")
  userActivityEntries  UserActivityEntry[]
  binOperationEntries  BinOperationEntry[]
  notifications        Notification[]
}

model Device {
  id           String     @id @default(uuid())
  name         String     @unique
  code         String     @unique
  warehouseId  String?
  zoneId       String?    @unique
  authorized   Boolean    @default(false)
  isActive     Boolean    @default(true)
  type         DeviceType @default(FLOOR)
  registeredAt DateTime   @default(now())
  lastSeenAt   DateTime?
  loginMode    LoginMode  @default(PIN)
  lastUserId   String?

  lastUser        User?      @relation("DeviceLastUser", fields: [lastUserId], references: [id])
  loggedInByUsers User[]     @relation("UserLastDevice")
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  zone            Zone?      @relation(fields: [zoneId], references: [id])
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  deviceLabel String
  deviceId    String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BinItem {
  id                String        @id @default(uuid())
  binId             String
  warItemId         String
  lotId             String?
  serialNumberId    String?
  quantityAvailable Decimal       @default(0)
  quantityReserved  Decimal       @default(0)
  quantityBlocked   Decimal       @default(0)
  uom               String
  status            BinItemStatus @default(AVAILABLE)
  expiryDate        DateTime?
  createdAt         DateTime      @default(now())

  bin          Bin           @relation(fields: [binId], references: [id])
  warItem      WARItem       @relation(fields: [warItemId], references: [id])
  lot          Lot?          @relation(fields: [lotId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])

  @@unique([binId, warItemId, lotId])
  @@unique([binId, warItemId, serialNumberId])
}

model WarehouseAssignment {
  id          String   @id @default(uuid())
  userId      String
  warehouseId String
  zoneId      String?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone      Zone?     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId, zoneId])
}

model WARItem {
  id           String           @id @default(uuid())
  sku          String           @unique
  name         String
  description  String?
  barcode      String?
  categoryId   String
  trackingMode ItemTrackingMode
  uom          String
  weightKg     Decimal?
  dimensions   Json?
  minQuantity  Decimal          @default(0)
  isActive     Boolean          @default(true)
  supplierId   String?
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())

  category            ItemCategory         @relation(fields: [categoryId], references: [id])
  binItems            BinItem[]
  lots                Lot[]
  serialNumbers       SerialNumber[]
  boxLines            BoxLine[]
  serialNumberConfigs SerialNumberConfig[]
}

model ItemCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  handlingFlags Json?
  createdAt     DateTime @default(now())

  items WARItem[]
}

model Lot {
  id              String    @id @default(uuid())
  lotNumber       String    @unique
  warItemId       String
  purchaseOrderId String?
  receivedDate    DateTime
  expiryDate      DateTime?
  status          LotStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())

  warItem  WARItem   @relation(fields: [warItemId], references: [id])
  binItems BinItem[]
  boxLines BoxLine[]
}

model SerialNumber {
  id             String           @id @default(uuid())
  serial         String           @unique
  configId       String
  entityType     SerialEntityType
  baseValue      Int
  partialCurrent Int?
  partialTotal   Int?
  status         SerialStatus     @default(IN_STOCK)
  warItemId      String?
  createdAt      DateTime         @default(now())

  config   SerialNumberConfig @relation(fields: [configId], references: [id])
  warItem  WARItem?           @relation(fields: [warItemId], references: [id])
  binItems BinItem[]
  boxLines BoxLine[]
}

model SerialNumberConfig {
  id          String           @id @default(uuid())
  entityType  SerialEntityType
  prefix      String?
  format      String
  lastValue   Int              @default(0)
  incrementBy Int              @default(1)
  mode        SerialMode       @default(INCREMENTAL)
  warItemId   String?
  warehouseId String?
  createdAt   DateTime         @default(now())

  warItem   WARItem?       @relation(fields: [warItemId], references: [id])
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])
  serials   SerialNumber[]
}

model Box {
  id          String    @id @default(uuid())
  code        String    @unique
  status      BoxStatus @default(OPEN)
  binId       String?
  warehouseId String
  weightKg    Decimal?
  notes       String?
  createdAt   DateTime  @default(now())

  bin       Bin?      @relation(fields: [binId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lines     BoxLine[]
}

model BoxLine {
  id             String  @id @default(uuid())
  boxId          String
  warItemId      String
  quantity       Decimal
  lotId          String?
  serialNumberId String?
  uom            String

  box          Box           @relation(fields: [boxId], references: [id], onDelete: Cascade)
  warItem      WARItem       @relation(fields: [warItemId], references: [id])
  lot          Lot?          @relation(fields: [lotId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])
}

model PurchaseOrder {
  id                String        @id @default(uuid())
  reference         String        @unique
  status            OrderStatus   @default(DRAFT)
  priority          OrderPriority @default(NORMAL)
  warehouseId       String
  notes             String?
  supplier          String
  expectedDate      DateTime?
  receivingSequence Int?
  createdById       String
  confirmedById     String?
  confirmedAt       DateTime?
  assignedWMId      String?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  warItemId       String
  binId           String?
  baseQuantity    Decimal
  handledQuantity Decimal @default(0)
  isShort         Boolean @default(false)
  lotId           String?
  serialNumberId  String?
  uom             String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id              String        @id @default(uuid())
  reference       String        @unique
  status          OrderStatus   @default(DRAFT)
  priority        OrderPriority @default(NORMAL)
  warehouseId     String
  notes           String?
  customerName    String
  deliveryAddress String?
  carrierId       String?
  createdById     String
  confirmedById   String?
  confirmedAt     DateTime?
  assignedWMId    String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     SalesOrderLine[]
}

model SalesOrderLine {
  id               String  @id @default(uuid())
  salesOrderId     String
  warItemId        String
  destinationBinId String?
  originBinId      String?
  baseQuantity     Decimal
  handledQuantity  Decimal @default(0)
  isShort          Boolean @default(false)
  lotId            String?
  serialNumberId   String?
  uom              String

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model TransferOrder {
  id               String        @id @default(uuid())
  reference        String        @unique
  status           OrderStatus   @default(DRAFT)
  priority         OrderPriority @default(NORMAL)
  warehouseId      String
  notes            String?
  destinationBinId String?
  originBinId      String?
  isCrossWarehouse Boolean       @default(false)
  createdById      String
  confirmedById    String?
  confirmedAt      DateTime?
  assignedWMId     String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())

  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  originBin      Bin?                @relation("TransferFromBin", fields: [originBinId], references: [id])
  destinationBin Bin?                @relation("TransferToBin", fields: [destinationBinId], references: [id])
  lines          TransferOrderLine[]
}

model TransferOrderLine {
  id              String  @id @default(uuid())
  transferOrderId String
  warItemId       String
  binId           String?
  baseQuantity    Decimal
  handledQuantity Decimal @default(0)
  isShort         Boolean @default(false)
  lotId           String?
  serialNumberId  String?
  uom             String

  transferOrder TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
}

model ReturnOrder {
  id                 String        @id @default(uuid())
  reference          String        @unique
  status             OrderStatus   @default(DRAFT)
  priority           OrderPriority @default(NORMAL)
  warehouseId        String
  notes              String?
  originSalesOrderId String?
  returnDisposition  String?
  createdById        String
  confirmedById      String?
  confirmedAt        DateTime?
  assignedWMId       String?
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  lines     ReturnOrderLine[]
}

model ReturnOrderLine {
  id              String  @id @default(uuid())
  returnOrderId   String
  warItemId       String
  binId           String?
  baseQuantity    Decimal
  handledQuantity Decimal @default(0)
  isShort         Boolean @default(false)
  lotId           String?
  serialNumberId  String?
  uom             String

  returnOrder ReturnOrder @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
}

model AdjustmentOrder {
  id            String        @id @default(uuid())
  reference     String        @unique
  status        OrderStatus   @default(DRAFT)
  priority      OrderPriority @default(NORMAL)
  warehouseId   String
  notes         String?
  reasonCode    String
  createdById   String
  confirmedById String?
  confirmedAt   DateTime?
  assignedWMId  String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  lines     AdjustmentOrderLine[]
}

model AdjustmentOrderLine {
  id                String  @id @default(uuid())
  adjustmentOrderId String
  warItemId         String
  binId             String?
  baseQuantity      Decimal
  handledQuantity   Decimal @default(0)
  isShort           Boolean @default(false)
  lotId             String?
  serialNumberId    String?
  uom               String

  adjustmentOrder AdjustmentOrder @relation(fields: [adjustmentOrderId], references: [id], onDelete: Cascade)
}

model UserActivityEntry {
  id          String     @id @default(uuid())
  userId      String
  actionType  String
  entityType  String
  entityId    String
  metadata    Json?
  warehouseId String?
  orderId     String?
  orderType   OrderType?
  ipAddress   String?
  notes       String?
  createdAt   DateTime   @default(now())

  user      User                @relation(fields: [userId], references: [id])
  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id])
  boes      BinOperationEntry[]
}

model BinOperationEntry {
  id             String     @id @default(uuid())
  userId         String
  fromBinId      String?
  toBinId        String?
  warItemId      String
  quantity       Decimal
  lotId          String?
  serialNumberId String?
  orderId        String?
  orderType      OrderType?
  uaeId          String
  createdAt      DateTime   @default(now())

  user        User              @relation(fields: [userId], references: [id])
  uae         UserActivityEntry @relation(fields: [uaeId], references: [id])
  itemLedgers ItemLedgerEntry[]
}

model ItemLedgerEntry {
  id             String          @id @default(uuid())
  warehouseId    String
  warItemId      String
  entryType      LedgerEntryType
  quantityChange Decimal
  lotId          String?
  serialNumberId String?
  orderId        String?
  orderType      OrderType?
  boeId          String
  createdAt      DateTime        @default(now())

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  boe       BinOperationEntry @relation(fields: [boeId], references: [id])
}

model AlertRule {
  id            String        @id @default(uuid())
  type          AlertRuleType
  warehouseId   String
  warItemId     String?
  threshold     Int
  recipientRole Role
  createdAt     DateTime      @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FiscalInventoryEventType {
  RECEIPT
  SHIPMENT
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum BinOperationType {
  RECEIVE
  PUTAWAY
  MOVE
  PICK
  SHIP
  BOX
  UNBOX
  ADJUST
  BLOCK
  UNBLOCK
  COUNT
  TRANSFER_LOAD
  TRANSFER_UNLOAD
  RETURN_RECEIVE
  RETURN_PUTAWAY
  REVERSE_OPERATION
}

enum BinItemStatus {
  AVAILABLE
  RESERVED
  BLOCKED
  IN_TRANSIT
}

enum Role {
  OWNER
  OFFICE_MANAGER
  OFFICE_WORKER
  WAREHOUSE_MANAGER
  WAREHOUSE_WORKER
}

enum LoginType {
  CREDENTIAL
  BADGE_PIN
  BOTH
}

enum LoginMode {
  PIN
  AUTOMATIC
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ZoneType {
  RECEIVING
  STORAGE
  PICKING
  PACKING
  SHIPPING
  QUARANTINE
  CUSTOM
}

enum BinType {
  RECEIVING
  STORAGE
  PICKING
  PACKING
  SHIPPING
  QUARANTINE
  STAGING
  CUSTOM
}

enum ItemTrackingMode {
  NONE
  LOT
  SERIAL
  FIFO
}

enum LotStatus {
  ACTIVE
  QUARANTINE
  EXPIRED
  CONSUMED
}

enum SerialStatus {
  IN_STOCK
  SHIPPED
  RETURNED
  SCRAPPED
}

enum SerialEntityType {
  ITEM
  BOX
  BOX_LINE
  PALLET
  ORDER
  ORDER_LINE
  USER
}

enum SerialMode {
  INCREMENTAL
  PARTIAL
}

enum BoxStatus {
  OPEN
  SEALED
  IN_TRANSIT
  RECEIVED
  SHIPPED
  SCRAPPED
}

enum OrderPriority {
  NORMAL
  URGENT
  EXPRESS
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  RELEASED
  EXECUTING
  PAUSED
  EXECUTED
  EXECUTED_WITH_PROBLEMS
  SIGNED_OFF
  CANCELLED
}

enum OrderType {
  PURCHASE
  SALES
  TRANSFER
  RETURN
  ADJUSTMENT
}

enum LedgerEntryType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  TRANSFER
}

enum AlertRuleType {
  LOW_STOCK
  EXPIRY
  BIN_CAPACITY
}

enum DeviceType {
  FLOOR
}

enum BusinessPartyType {
  CUSTOMER
  SUPPLIER
  CARRIER
}

enum AddressType {
  PRIMARY
  BILLING
  SHIPPING
  RETURNS
  WAREHOUSE
  HQ
}

model UnitOfMeasure {
  id           String   @id
  description  String
  decimalRound Int
  createdAt    DateTime @default(now())

  items                Item[]
  binStockItems        BinStockItem[]
  boxLines             BoxLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  salesOrderLines      SalesOrderLine[]
  transferOrderLines   TransferOrderLine[]
  returnOrderLines     ReturnOrderLine[]
  adjustmentOrderLines AdjustmentOrderLine[]
  binOperationEntries  BinOperationEntry[]
  itemLedgerEntries    ItemLedgerEntry[]
}

model BusinessParty {
  id        String            @id
  code      String            @unique
  type      BusinessPartyType
  name      String
  legalName String?
  email     String?
  phone     String?
  website   String?
  vatNumber String?
  taxId     String?
  isActive  Boolean           @default(true)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  contacts       ContactPerson[]
  addresses      Address[]
  purchaseOrders PurchaseOrder[] @relation("SupplierPurchaseOrders")
  salesOrders    SalesOrder[]    @relation("CustomerSalesOrders")
}

model ContactPerson {
  id              String   @id
  businessPartyId String
  firstName       String
  lastName        String
  fullName        String
  roleTitle       String?
  email           String?
  phone           String?
  mobile          String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  businessParty BusinessParty @relation(fields: [businessPartyId], references: [id], onDelete: Cascade)

  @@index([businessPartyId])
}

model Address {
  id              String      @id
  businessPartyId String
  type            AddressType
  label           String?
  streetLine1     String
  streetLine2     String?
  city            String
  state           String?
  postalCode      String
  country         String
  isPrimary       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  businessParty BusinessParty @relation(fields: [businessPartyId], references: [id], onDelete: Cascade)

  @@index([businessPartyId])
}

model Warehouse {
  id          String          @id
  name        String          @unique
  address     String?
  timezone    String?
  currency    String?
  status      WarehouseStatus @default(ACTIVE)
  createdById String?
  createdBy   User?           @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())

  zones               Zone[]
  bins                Bin[]
  devices             Device[]
  assignments         WarehouseAssignment[]
  purchaseOrders      PurchaseOrder[]
  salesOrders         SalesOrder[]
  transferOrders      TransferOrder[]
  returnOrders        ReturnOrder[]
  adjustOrders        AdjustmentOrder[]
  itemLedger          ItemLedgerEntry[]
  alertRules          AlertRule[]
  uaeEntries          UserActivityEntry[]
  serialConfigs       SerialNumberConfig[]
  boxes               Box[]
  binOperationEntries BinOperationEntry[]
}

model Zone {
  id                     String    @id
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  name                   String
  type                   ZoneType
  customPermissions      Json?
  isActive               Boolean   @default(true)
  defaultReceivingBinId  String?
  defaultQuarantineBinId String?
  defaultOutgoingBinId   String?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())

  bins        Bin[]
  devices     Device[]
  assignments WarehouseAssignment[]

  @@unique([warehouseId, name])
}

model Bin {
  id              String    @id
  zoneId          String
  warehouseId     String
  zone            Zone      @relation(fields: [zoneId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  name            String
  code            String    @unique
  type            BinType
  isBlocked       Boolean   @default(false)
  blockReason     String?
  maxCapacity     Decimal?  @db.Decimal(18, 4)
  currentCapacity Decimal?  @db.Decimal(18, 4)
  maxWeightKg     Decimal?  @db.Decimal(18, 4)
  maxVolumeM3     Decimal?  @db.Decimal(18, 4)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  binStockItems BinStockItem[]
  fromTransfers TransferOrder[] @relation("TransferFromBin")
  toTransfers   TransferOrder[] @relation("TransferToBin")
  boxes         Box[]
}

model User {
  id                String    @id
  email             String?   @unique
  passwordHash      String?
  badgeNumber       String    @unique
  pinHash           String?
  firstName         String
  lastName          String
  fullName          String    @default("${firstName} ${lastName}")
  role              Role
  loginType         LoginType
  isActive          Boolean   @default(true)
  isLoggedIn        Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  lastLoginDeviceId String?

  lastLoginDevice      Device?               @relation("UserLastDevice", fields: [lastLoginDeviceId], references: [id])
  usedByDevices        Device[]              @relation("DeviceLastUser")
  refreshTokens        RefreshToken[]
  warehouseAssignments WarehouseAssignment[]
  orderAssignments     OrderAssignment[]
  createdWarehouses    Warehouse[]           @relation("WarehouseCreatedBy")
  userActivityEntries  UserActivityEntry[]
  binOperationEntries  BinOperationEntry[]
  notifications        Notification[]
  purchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderAssignedTo")
}

model Device {
  id           String     @id @default(uuid())
  name         String     @unique
  code         String     @unique
  warehouseId  String?
  zoneId       String?    @unique
  authorized   Boolean    @default(false)
  isActive     Boolean    @default(true)
  type         DeviceType @default(FLOOR)
  registeredAt DateTime   @default(now())
  lastSeenAt   DateTime?
  loginMode    LoginMode  @default(PIN)
  lastUserId   String?

  lastUser        User?      @relation("DeviceLastUser", fields: [lastUserId], references: [id])
  loggedInByUsers User[]     @relation("UserLastDevice")
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  zone            Zone?      @relation(fields: [zoneId], references: [id])
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  deviceLabel String
  deviceId    String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BinStockItem {
  id                String  @id @default(uuid())
  warehouseId       String
  binId             String
  itemId            String
  description       String
  boxId             String?
  lotId             String?
  serialNumberId    String?
  quantityAvailable Decimal @default(0) @db.Decimal(18, 4)
  quantityReserved  Decimal @default(0) @db.Decimal(18, 4)
  quantityBlocked   Decimal @default(0) @db.Decimal(18, 4)
  reservedByOrderId String?
  uom               String

  unitOfMeasure      UnitOfMeasure @relation(fields: [uom], references: [id])
  status             BinItemStatus @default(AVAILABLE)
  expiryDate         DateTime?
  createdByBoeId     String?
  lastOperationBoeId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bin          Bin           @relation(fields: [binId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  lot          Lot?          @relation(fields: [lotId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])
  boxLines     BoxLine[]

  @@unique([binId, itemId, lotId, serialNumberId])
  @@index([warehouseId, itemId])
  @@index([binId, itemId])
  @@index([status])
}

model WarehouseAssignment {
  id          String   @id @default(uuid())
  userId      String
  warehouseId String
  zoneId      String?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone      Zone?     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId, zoneId])
}

model OrderAssignment {
  id        String    @id @default(uuid())
  orderId   String
  orderType OrderType
  userId    String
  createdAt DateTime  @default(now())

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userActivities UserActivityEntry[] @relation("OrderAssignmentActivities")

  @@unique([orderType, orderId, userId])
  @@index([userId])
  @@index([orderType, orderId])
}

model Item {
  id           String           @id @default(uuid())
  sku          String           @unique
  name         String
  description  String?
  barcode      String?
  categoryId   String
  trackingMode ItemTrackingMode
  uom          String

  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])
  weightKg      Decimal?
  dimensions    Json?
  minQuantity   Decimal       @default(0)
  isActive      Boolean       @default(true)
  supplierId    String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())

  category            ItemCategory         @relation(fields: [categoryId], references: [id])
  binStockItems       BinStockItem[]
  lots                Lot[]
  serialNumbers       SerialNumber[]
  serialNumberConfigs SerialNumberConfig[]
}

model ItemCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  handlingFlags Json?
  createdAt     DateTime @default(now())

  items Item[]
}

model Lot {
  id              String    @id @default(uuid())
  lotNumber       String    @unique
  purchaseOrderId String?
  receivedDate    DateTime
  expiryDate      DateTime?
  status          LotStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())

  binStockItems BinStockItem[]
  boxLines      BoxLine[]
  item          Item?          @relation(fields: [itemId], references: [id])
  itemId        String?
}

model SerialNumber {
  id             String           @id @default(uuid())
  serial         String           @unique
  configId       String
  entityType     SerialEntityType
  baseValue      Int
  partialCurrent Int?
  partialTotal   Int?
  status         SerialStatus     @default(IN_STOCK)
  itemId         String?
  createdAt      DateTime         @default(now())

  config        SerialNumberConfig @relation(fields: [configId], references: [id])
  item          Item?              @relation(fields: [itemId], references: [id])
  binStockItems BinStockItem[]
  boxLines      BoxLine[]
}

model SerialNumberConfig {
  id          String           @id @default(uuid())
  entityType  SerialEntityType
  prefix      String?
  format      String
  lastValue   Int              @default(0)
  incrementBy Int              @default(1)
  mode        SerialMode       @default(INCREMENTAL)
  itemId      String?
  warehouseId String?
  createdAt   DateTime         @default(now())

  item      Item?          @relation(fields: [itemId], references: [id])
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])
  serials   SerialNumber[]
}

model Box {
  id          String    @id @default(uuid())
  code        String    @unique
  status      BoxStatus @default(OPEN)
  binId       String?
  warehouseId String
  weightKg    Decimal?
  notes       String?
  createdAt   DateTime  @default(now())

  bin       Bin?      @relation(fields: [binId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lines     BoxLine[]
}

model BoxLine {
  id             String  @id @default(uuid())
  boxId          String
  itemId         String
  quantity       Decimal
  lotId          String?
  serialNumberId String?
  uom            String

  box           Box           @relation(fields: [boxId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])
  item          BinStockItem  @relation(fields: [itemId], references: [id])
  lot           Lot?          @relation(fields: [lotId], references: [id])
  serialNumber  SerialNumber? @relation(fields: [serialNumberId], references: [id])
}

model PurchaseOrder {
  id                String        @id @default(uuid())
  reference         String        @unique
  status            OrderStatus   @default(DRAFT)
  priority          OrderPriority @default(NORMAL)
  assignedToId      String?
  warehouseId       String
  notes             String?
  supplier          String
  expectedDate      DateTime?
  receivingSequence Int?
  createdById       String
  confirmedById     String?
  confirmedAt       DateTime?
  assignedWMId      String?
  deletedAt         DateTime?
  businessPartyId   String?
  createdAt         DateTime      @default(now())

  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id])
  lines               PurchaseOrderLine[]
  businessParty       BusinessParty?      @relation("SupplierPurchaseOrders", fields: [businessPartyId], references: [id])
  userActivityEntry   UserActivityEntry?  @relation("UserActivityPurchaseOrders", fields: [userActivityEntryId], references: [id])
  userActivityEntryId String?
  assignedTo          User?               @relation("PurchaseOrderAssignedTo", fields: [assignedToId], references: [id])
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  warItemId       String
  binId           String?
  baseQuantity    Decimal
  handledQuantity Decimal @default(0)
  isShort         Boolean @default(false)
  lotId           String?
  serialNumberId  String?
  uom             String

  purchaseOrder       PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure       UnitOfMeasure      @relation(fields: [uom], references: [id])
  userActivityEntry   UserActivityEntry? @relation("UserActivityPurchaseOrderLines", fields: [userActivityEntryId], references: [id])
  userActivityEntryId String?
}

model SalesOrder {
  id              String        @id @default(uuid())
  reference       String        @unique
  status          OrderStatus   @default(DRAFT)
  priority        OrderPriority @default(NORMAL)
  warehouseId     String
  notes           String?
  customerName    String
  deliveryAddress String?
  carrierId       String?
  createdById     String
  confirmedById   String?
  confirmedAt     DateTime?
  assignedWMId    String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id])
  lines               SalesOrderLine[]
  businessPartyId     String?
  businessParty       BusinessParty?     @relation("CustomerSalesOrders", fields: [businessPartyId], references: [id])
  userActivityEntry   UserActivityEntry? @relation("UserActivitySalesOrders", fields: [userActivityEntryId], references: [id])
  userActivityEntryId String?
}

model SalesOrderLine {
  id               String  @id @default(uuid())
  salesOrderId     String
  warItemId        String
  destinationBinId String?
  originBinId      String?
  baseQuantity     Decimal
  handledQuantity  Decimal @default(0)
  isShort          Boolean @default(false)
  lotId            String?
  serialNumberId   String?
  uom              String

  salesOrder          SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure       UnitOfMeasure      @relation(fields: [uom], references: [id])
  userActivityEntry   UserActivityEntry? @relation("UserActivitySalesOrderLines", fields: [userActivityEntryId], references: [id])
  userActivityEntryId String?
}

model TransferOrder {
  id               String        @id @default(uuid())
  reference        String        @unique
  status           OrderStatus   @default(DRAFT)
  priority         OrderPriority @default(NORMAL)
  warehouseId      String
  notes            String?
  destinationBinId String?
  originBinId      String?
  isCrossWarehouse Boolean       @default(false)
  createdById      String
  confirmedById    String?
  confirmedAt      DateTime?
  assignedWMId     String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())

  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  originBin      Bin?                @relation("TransferFromBin", fields: [originBinId], references: [id])
  destinationBin Bin?                @relation("TransferToBin", fields: [destinationBinId], references: [id])
  lines          TransferOrderLine[]
}

model TransferOrderLine {
  id              String  @id @default(uuid())
  transferOrderId String
  warItemId       String
  binId           String?
  baseQuantity    Decimal
  handledQuantity Decimal @default(0)
  isShort         Boolean @default(false)
  lotId           String?
  serialNumberId  String?
  uom             String

  transferOrder TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])
}

model ReturnOrder {
  id                 String        @id @default(uuid())
  reference          String        @unique
  status             OrderStatus   @default(DRAFT)
  priority           OrderPriority @default(NORMAL)
  warehouseId        String
  notes              String?
  originSalesOrderId String?
  returnDisposition  String?
  createdById        String
  confirmedById      String?
  confirmedAt        DateTime?
  assignedWMId       String?
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  lines     ReturnOrderLine[]
}

model ReturnOrderLine {
  id              String  @id @default(uuid())
  returnOrderId   String
  warItemId       String
  binId           String?
  baseQuantity    Decimal
  handledQuantity Decimal @default(0)
  isShort         Boolean @default(false)
  lotId           String?
  serialNumberId  String?
  uom             String

  returnOrder   ReturnOrder   @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure @relation(fields: [uom], references: [id])
}

model AdjustmentOrder {
  id            String        @id @default(uuid())
  reference     String        @unique
  status        OrderStatus   @default(DRAFT)
  priority      OrderPriority @default(NORMAL)
  warehouseId   String
  notes         String?
  reasonCode    String
  createdById   String
  confirmedById String?
  confirmedAt   DateTime?
  assignedWMId  String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())

  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id])
  lines               AdjustmentOrderLine[]
  userActivityEntry   UserActivityEntry?    @relation("UserActivityAdjustmentOrders", fields: [userActivityEntryId], references: [id])
  userActivityEntryId String?
}

model AdjustmentOrderLine {
  sequence          Int     @default(autoincrement())
  adjustmentOrderId String
  warItemId         String
  binId             String?
  baseQuantity      Decimal
  handledQuantity   Decimal @default(0)
  isShort           Boolean @default(false)
  lotId             String?
  serialNumberId    String?
  uom               String

  adjustmentOrder     AdjustmentOrder    @relation(fields: [adjustmentOrderId], references: [id], onDelete: Cascade)
  unitOfMeasure       UnitOfMeasure      @relation(fields: [uom], references: [id])
  userActivityEntry   UserActivityEntry? @relation("UserActivityAdjustmentOrderLines", fields: [userActivityEntryId], references: [id])
  userActivityEntryId String?

  @@id([adjustmentOrderId, sequence])
}

model UserActivityEntry {
  id                String     @id @default(uuid())
  userId            String
  actionType        String
  entityType        String
  entityId          String
  metadata          Json?
  warehouseId       String?
  orderId           String?
  orderType         OrderType?
  orderAssignmentId String?
  ipAddress         String?
  notes             String?
  createdAt         DateTime   @default(now())

  user                 User                  @relation(fields: [userId], references: [id])
  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id])
  orderAssignment      OrderAssignment?      @relation("OrderAssignmentActivities", fields: [orderAssignmentId], references: [id], onDelete: SetNull)
  boes                 BinOperationEntry[]
  salesOrderLines      SalesOrderLine[]      @relation("UserActivitySalesOrderLines")
  purchaseOrderLines   PurchaseOrderLine[]   @relation("UserActivityPurchaseOrderLines")
  adjustmentOrderLines AdjustmentOrderLine[] @relation("UserActivityAdjustmentOrderLines")
  adjustmentOrder      AdjustmentOrder[]     @relation("UserActivityAdjustmentOrders")
  purchaseOrder        PurchaseOrder[]       @relation("UserActivityPurchaseOrders")
  salesOrder           SalesOrder[]          @relation("UserActivitySalesOrders")

  @@index([userId, actionType, entityId, entityType])
  @@index([orderAssignmentId])
}

model BinOperationEntry {
  id          String           @id @default(uuid())
  type        BinOperationType
  warehouseId String
  userId      String
  fromBinId   String?
  toBinId     String?
  warItemId   String
  quantity    Decimal          @db.Decimal(18, 4)
  uom         String

  unitOfMeasure      UnitOfMeasure @relation(fields: [uom], references: [id])
  lotId              String?
  serialNumberId     String?
  boxId              String?
  orderId            String?
  orderType          OrderType?
  reasonCode         String?
  notes              String?
  affectsFiscalStock Boolean       @default(false)
  reversedByEntryId  String?
  reversesEntryId    String?
  createdAt          DateTime      @default(now())

  user                User               @relation(fields: [userId], references: [id])
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id])
  itemLedgers         ItemLedgerEntry[]
  userActivityEntry   UserActivityEntry? @relation(fields: [userActivityEntryId], references: [id])
  userActivityEntryId String?

  @@index([warehouseId, warItemId, createdAt])
  @@index([fromBinId, createdAt])
  @@index([toBinId, createdAt])
  @@index([type, createdAt])
  @@index([orderType, orderId])
}

model ItemLedgerEntry {
  id            Int                      @id @default(autoincrement())
  warehouseId   String
  warItemId     String
  eventType     FiscalInventoryEventType
  quantityDelta Decimal                  @db.Decimal(18, 4)
  uom           String
  lotId         String?

  unitOfMeasure       UnitOfMeasure @relation(fields: [uom], references: [id])
  serialNumberId      String?
  orderId             String?
  orderType           OrderType?
  reference           String?
  reasonCode          String?
  externalDocumentRef String?
  boeId               String?
  performedByUserId   String?
  createdAt           DateTime      @default(now())

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  boe       BinOperationEntry? @relation(fields: [boeId], references: [id])

  @@index([warehouseId, warItemId, createdAt])
  @@index([warehouseId, eventType, createdAt])
  @@index([orderType, orderId])
  @@index([lotId])
  @@index([serialNumberId])
}

model AlertRule {
  id            String        @id @default(uuid())
  type          AlertRuleType
  warehouseId   String
  warItemId     String?
  threshold     Int
  recipientRole Role
  createdAt     DateTime      @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
